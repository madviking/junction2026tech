# Junction 2026 environment template (NO REAL SECRETS)
# Copy to `.env` (gitignored): `cp .env.example .env`
# Docker Compose and the backend both read `.env`.

ENVIRONMENT=local

# --- Data services (local Docker only; ports bound to 127.0.0.1) ---
POSTGRES_PASSWORD=app_local_only
POSTGRES_PORT=5434
REDIS_PORT=6381
# Backend on the host talks to the Docker ports above.
DATABASE_URL=postgresql://app:app_local_only@localhost:5434/app
REDIS_URL=redis://localhost:6381/0

# --- App ports ---
BACKEND_PORT=8300
FRONTEND_PORT=5300

# --- LLM providers (set only what you use) ---
# OpenRouter is the default provider for every integration seed.
OPEN_ROUTER_API_KEY=
# Direct OpenAI (optional).
OPENAI_API_KEY=
# Mistral = East's local vLLM host. Reachable only through an SSH tunnel:
#   ssh -N -L 18001:127.0.0.1:8001 <you>@<mistral-host>   (see East Deploy operate-mistral runbook)
MISTRAL_BASE_URL=http://localhost:18001/v1
MISTRAL_API_KEY=

# Per-feature model override (optional): LLM_MODEL__<FEATURE_KEY_UPPER>=<model id>
# e.g. LLM_MODEL__EXAMPLE_SUMMARY=openai/gpt-4.1-nano
