# Silta environment template (NO REAL SECRETS)
# Copy to `.env` (gitignored): `cp .env.example .env`
# `encore run` provisions its own Postgres. Provider keys reach the local app through
# backend/.secrets.local.cue, which `make secrets` (part of `make setup`) writes from here. They are for the self-hosted
# image (make migrate-aiven, make run-image) and the deployed app.

# --- App ports (local) ---
BACKEND_PORT=8300
FRONTEND_PORT=5300

# --- Aiven for PostgreSQL (values from the Aiven console) ---
# Password of the database user named in backend/infra.config.json.
AIVEN_PG_PASSWORD=

# --- Provider secrets, mapped to Encore secrets in backend/infra.config.json ---
GEMINI_API_KEY=
OPEN_ROUTER_API_KEY=
ELEVEN_LABS_API_KEY=
# HMAC pepper for visit codes. Local: generated by `make secrets` when empty.
VISIT_CODE_PEPPER=
