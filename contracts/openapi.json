{
  "components": {
    "schemas": {
      "DependencyCheck": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "state": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "name",
          "state"
        ],
        "title": "DependencyCheck",
        "type": "object"
      },
      "HealthStatus": {
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/DependencyCheck"
            },
            "title": "Checks",
            "type": "array"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "environment",
          "checks"
        ],
        "title": "HealthStatus",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Junction 2026 API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "Liveness plus dependency status. Always 200 so containers stay up while degraded.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Health",
        "tags": [
          "health"
        ]
      }
    }
  }
}
