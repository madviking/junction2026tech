{
  "components": {
    "schemas": {
      "Adaptation": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "how": {
            "title": "How",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "right": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Right"
          }
        },
        "required": [
          "code",
          "name",
          "how"
        ],
        "title": "Adaptation",
        "type": "object"
      },
      "CarePath": {
        "properties": {
          "adaptations": {
            "items": {
              "$ref": "#/components/schemas/Adaptation"
            },
            "title": "Adaptations",
            "type": "array"
          },
          "barriers": {
            "items": {
              "type": "string"
            },
            "title": "Barriers",
            "type": "array"
          },
          "clocks": {
            "items": {
              "$ref": "#/components/schemas/Clock"
            },
            "title": "Clocks",
            "type": "array"
          },
          "destination": {
            "$ref": "#/components/schemas/Destination"
          },
          "emergency": {
            "title": "Emergency",
            "type": "boolean"
          },
          "lane": {
            "title": "Lane",
            "type": "string"
          },
          "profile": {
            "title": "Profile",
            "type": "string"
          },
          "review_flags": {
            "items": {
              "$ref": "#/components/schemas/ReviewFlag"
            },
            "title": "Review Flags",
            "type": "array"
          },
          "route": {
            "title": "Route",
            "type": "string"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/Step"
            },
            "title": "Steps",
            "type": "array"
          }
        },
        "required": [
          "lane",
          "route",
          "profile",
          "barriers",
          "emergency",
          "destination",
          "clocks",
          "adaptations",
          "steps",
          "review_flags"
        ],
        "title": "CarePath",
        "type": "object"
      },
      "CarePathOptions": {
        "properties": {
          "barriers": {
            "items": {
              "$ref": "#/components/schemas/Option"
            },
            "title": "Barriers",
            "type": "array"
          },
          "lanes": {
            "items": {
              "$ref": "#/components/schemas/Option"
            },
            "title": "Lanes",
            "type": "array"
          },
          "profiles": {
            "items": {
              "$ref": "#/components/schemas/Option"
            },
            "title": "Profiles",
            "type": "array"
          },
          "routes": {
            "items": {
              "$ref": "#/components/schemas/Option"
            },
            "title": "Routes",
            "type": "array"
          }
        },
        "required": [
          "lanes",
          "routes",
          "profiles",
          "barriers"
        ],
        "title": "CarePathOptions",
        "type": "object"
      },
      "Clock": {
        "properties": {
          "basis": {
            "enum": [
              "legal",
              "recommended",
              "open"
            ],
            "title": "Basis",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "limit": {
            "title": "Limit",
            "type": "string"
          }
        },
        "required": [
          "label",
          "limit",
          "basis"
        ],
        "title": "Clock",
        "type": "object"
      },
      "ComposeRequest": {
        "properties": {
          "barriers": {
            "description": "Barrier codes, e.g. B6",
            "items": {
              "type": "string"
            },
            "title": "Barriers",
            "type": "array"
          },
          "lane": {
            "description": "Urgency lane code, e.g. U2",
            "title": "Lane",
            "type": "string"
          },
          "profile": {
            "description": "Communication profile code, e.g. C2",
            "title": "Profile",
            "type": "string"
          },
          "route": {
            "description": "Access route code, e.g. A1",
            "title": "Route",
            "type": "string"
          }
        },
        "required": [
          "lane",
          "route",
          "profile"
        ],
        "title": "ComposeRequest",
        "type": "object"
      },
      "DependencyCheck": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "state": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "name",
          "state"
        ],
        "title": "DependencyCheck",
        "type": "object"
      },
      "Destination": {
        "properties": {
          "note": {
            "title": "Note",
            "type": "string"
          },
          "script_fi": {
            "title": "Script Fi",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "script_fi",
          "note"
        ],
        "title": "Destination",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthStatus": {
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/DependencyCheck"
            },
            "title": "Checks",
            "type": "array"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "environment",
          "checks"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "Option": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "summary"
        ],
        "title": "Option",
        "type": "object"
      },
      "ReviewFlag": {
        "properties": {
          "kind": {
            "enum": [
              "clinical",
              "legal"
            ],
            "title": "Kind",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "message"
        ],
        "title": "ReviewFlag",
        "type": "object"
      },
      "Step": {
        "properties": {
          "adaptation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Code that added this step, if any",
            "title": "Adaptation"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "Step",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Junction 2026 API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/care-paths/compose": {
      "post": {
        "description": "Compose one person's path. Unknown codes return 422.",
        "operationId": "composeCarePath",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComposeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CarePath"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Compose",
        "tags": [
          "care-paths"
        ]
      }
    },
    "/api/care-paths/options": {
      "get": {
        "description": "Every urgency lane, access route, communication profile and barrier, in display order.",
        "operationId": "listCarePathOptions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CarePathOptions"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Options",
        "tags": [
          "care-paths"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Liveness plus dependency status. Always 200 so containers stay up while degraded.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Health",
        "tags": [
          "health"
        ]
      }
    }
  }
}
